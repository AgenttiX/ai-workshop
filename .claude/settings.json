{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git status:*)",
      "Bash(pyrefly check:*)",
      "Bash(pytest:*)",
      "Bash(python -m pytest:*)",
      "Bash(python -m workshop.check)",
      "Bash(ruff check:*)",
      "Bash(ruff format:*)"
    ]
  },
  "ask": [
    "Bash(git push:*)",
    "PowerShell(git push:*)"
  ],
  "enabledPlugins": {
    "claude-security@claude-plugins-official": true,
    "pyright-lsp@claude-plugins-official": true
  }
}
